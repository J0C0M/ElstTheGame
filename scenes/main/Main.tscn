theme_override_colors/font_color = Color(1, 1, 1, 0.9)
theme_override_colors/font_outline_color = Color(0.08, 0.06, 0.12, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 14
text = "WASD lopen · Shift sprinten · Spatie springen
E: gebruiken · Q: drankje · Tab: inventaris
Alt of dubbel tikken: ontwijken
Klik: aanval · nog een klik: combo
Klik vasthouden: zware aanval
Rechtermuis: blokkeren (op tijd = parry)
Esc: pauzemenu · F5/F9: snel opslaan/laden
F1 filter · F2 pixelgrootte"
horizontal_alignment = 2

