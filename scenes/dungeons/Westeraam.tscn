[sub_resource type="NavigationMesh" id="NavigationMesh_room"]
geometry_parsed_geometry_type = 1
geometry_collision_mask = 1
geometry_source_geometry_mode = 1
geometry_source_group_name = &"navigation_source"
cell_size = 0.5
cell_height = 0.25
agent_height = 1.75
agent_radius = 0.5
agent_max_climb = 0.5
agent_max_slope = 40.0
filter_baking_aabb = AABB(-11, -2, -16, 22, 10, 32)

[node name="WesteraamDungeon" type="Node3D"]
script = ExtResource("1_world")
location_name = "Westeraam Getho"
default_spawn = &"Entrance"
autosave_on_enter = true

