[sub_resource type="Resource" id="Line_first_meeting"]
script = ExtResource("4_line")
id = &"first_meeting"
text = "Hé. Jij bent nieuw hier. Dat zie ik aan je loopje."
next = &"first_2"
condition = SubResource("Condition_1")
model_action = &"flex"

[sub_resource type="Resource" id="Line_first_2"]
script = ExtResource("4_line")
id = &"first_2"
text = "Ik ben Klaas. Ik beschermde Elst. Tot Amber de Draak kwam, met haar leger drillers uit Arnhem-Zuid."
next = &"first_3"

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("3_choice")
text = "Wat moet ik doen?"
next = &"tutorial_1"

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"first_glasses"

[sub_resource type="Resource" id="Line_first_3"]
script = ExtResource("4_line")
id = &"first_3"
text = "Nu zit ik ondergedoken in mijn eigen huis. Niet mijn sterkste moment. Maar jij kunt me helpen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("3_choice")
text = "Wat moet ik doen?"
next = &"tutorial_1"

[sub_resource type="Resource" id="Line_first_glasses"]
script = ExtResource("4_line")
id = &"first_glasses"
text = "Deze bril gaat nooit af. Nooit. Volgende vraag."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_3")])

[sub_resource type="Resource" id="Line_tutorial_1"]
script = ExtResource("4_line")
id = &"tutorial_1"
text = "Eerst wil ik zien wat je kunt. Hier, een zwaard. Roestig, maar het snijdt."
next = &"tutorial_2"
action = &"give_item"
action_value = "rusty_sword"

[sub_resource type="Resource" id="Line_tutorial_2"]
script = ExtResource("4_line")
id = &"tutorial_2"
text = "Ga naar buiten. Sprint, spring en ontwijk. Sla daarna mijn trainingspop kapot en leer blokkeren bij de sparringpop."
next = &"tutorial_3"

[sub_resource type="Resource" id="Line_tutorial_3"]
script = ExtResource("4_line")
id = &"tutorial_3"
text = "Raak je de weg kwijt? Je questlog staat onder J, en het kompas bovenin wijst de weg. Vooruit."
action = &"set_flag"
action_value = "q1_met_klaas"

[sub_resource type="Resource" id="Line_tutorial_report"]
script = ExtResource("4_line")
id = &"tutorial_report"
text = "Twee drillers in één keer. Niet slecht, voor een niemand."
next = &"tutorial_reward"
condition = SubResource("Condition_2")
model_action = &"flex"

[sub_resource type="Resource" id="Line_tutorial_reward"]
script = ExtResource("4_line")
id = &"tutorial_reward"
text = "Je bent nu ingewijd. Mijn winkel staat voor je open. En hier, wat goud en twee drankjes. Niet alles in één keer opmaken."
next = &"hub"
action = &"set_flag"
action_value = "q1_reported"

[sub_resource type="Resource" id="Line_tutorial_busy"]
script = ExtResource("4_line")
id = &"tutorial_busy"
text = "Ik zie nog geen resultaten. Kijk in je questlog als je niet weet wat je moet doen."
condition = SubResource("Condition_3")

[sub_resource type="Resource" id="Line_q2_report"]
script = ExtResource("4_line")
id = &"q2_report"
text = "Het is stil op het spoor. Geen trein meer voor Amber. Dat heb jij gedaan."
next = &"q2_reward"
condition = SubResource("Condition_8")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q2_reward"]
script = ExtResource("4_line")
id = &"q2_reward"
text = "Zonder aanvoer zijn haar drillers in Westeraam en bij het OBC een stuk slapper. Hier, je beloning."
next = &"hub"
action = &"set_flag"
action_value = "q2_reported"

[sub_resource type="Resource" id="Line_q3_report"]
script = ExtResource("4_line")
id = &"q3_report"
text = "De Vape-koning is weg? Dan kan Westeraam eindelijk weer ademen."
next = &"q3_reward"
condition = SubResource("Condition_12")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q3_reward"]
script = ExtResource("4_line")
id = &"q3_reward"
text = "De mensen lopen alweer over straat. Hier, 150 goud. Die heb je verdiend."
next = &"hub"
action = &"set_flag"
action_value = "q3_reported"

[sub_resource type="Resource" id="Line_q4_report"]
script = ExtResource("4_line")
id = &"q4_report"
text = "Het fatbike-kindje van zijn fiets geduwd? Dat had ik graag gezien."
next = &"q4_reward"
condition = SubResource("Condition_17")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q4_reward"]
script = ExtResource("4_line")
id = &"q4_reward"
text = "Het OBC is weer van de leerlingen. Hier, 150 goud."
next = &"hub"
action = &"set_flag"
action_value = "q4_reported"

[sub_resource type="Resource" id="Line_q5_report"]
script = ExtResource("4_line")
id = &"q5_report"
text = "Grumpy Oma verslagen? Dan wordt het vanavond eindelijk weer een gezellige bingoavond."
next = &"q5_reward"
condition = SubResource("Condition_22")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q5_reward"]
script = ExtResource("4_line")
id = &"q5_reward"
text = "Hier, 150 goud. En er is meer."
next = &"q5_crossbow"
action = &"set_flag"
action_value = "q5_reported"

[sub_resource type="Resource" id="Line_q5_crossbow"]
script = ExtResource("4_line")
id = &"q5_crossbow"
text = "Je hebt al mijn klussen gedaan. Daarom krijg je mijn oude kruisboog. Druk op 2 om hem te pakken en houd de rechtermuisknop vast om te richten. Er zitten 15 pijlen bij. Meer koop je bij mij, of je vindt ze in kisten."
next = &"hub"
action = &"give_item"
action_value = "crossbow"

[sub_resource type="Resource" id="Line_greeting_strong"]
script = ExtResource("4_line")
id = &"greeting_strong"
text = "Kijk eens wie er spieren krijgt. Bijna zoveel als ik. Bijna."
next = &"hub"
condition = SubResource("Condition_27")
model_action = &"flex"

[sub_resource type="Resource" id="Line_greeting"]
script = ExtResource("4_line")
id = &"greeting"
text = "Daar is mijn favoriete niemand."
next = &"hub"

[sub_resource type="Resource" id="Choice_4"]
script = ExtResource("3_choice")
text = "Laat je winkel zien."
condition = SubResource("Condition_26")
action = &"open_shop"

[sub_resource type="Resource" id="Choice_5"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q2_offer"
condition = SubResource("Condition_5")

