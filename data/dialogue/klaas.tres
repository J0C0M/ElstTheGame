[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/dialogue_condition.gd" id="2_condition"]
[ext_resource type="Script" path="res://scripts/data/dialogue_choice.gd" id="3_choice"]
[ext_resource type="Script" path="res://scripts/data/dialogue_line.gd" id="4_line"]

[sub_resource type="Resource" id="Condition_1"]
script = ExtResource("2_condition")
required_flag = &"met_klaas"

[sub_resource type="Resource" id="Condition_2"]
script = ExtResource("2_condition")
forbidden_flag = &"met_klaas"

[sub_resource type="Resource" id="Condition_3"]
script = ExtResource("2_condition")
min_inwijding = 1

[sub_resource type="Resource" id="Condition_4"]
script = ExtResource("2_condition")
max_inwijding = 0

[sub_resource type="Resource" id="Condition_5"]
script = ExtResource("2_condition")
min_inwijding = 3
required_flag = &"met_klaas"

[sub_resource type="Resource" id="Line_first_meeting"]
script = ExtResource("4_line")
id = &"first_meeting"
text = "Hé. Jij bent nieuw hier. Dat zie ik aan je loopje."
next = &"first_2"
condition = SubResource("Condition_2")
action = &"set_flag"
action_value = "met_klaas"
model_action = &"flex"

[sub_resource type="Resource" id="Line_first_2"]
script = ExtResource("4_line")
id = &"first_2"
text = "Ik ben Klaas. Ik beschermde Elst. Tot Amber de Draak kwam, met haar leger drillers uit Arnhem-Zuid."
next = &"first_3"

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("3_choice")
text = "Wat moet ik doen?"
next = &"task"

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"glasses"

[sub_resource type="Resource" id="Line_first_3"]
script = ExtResource("4_line")
id = &"first_3"
text = "Nu zit ik ondergedoken in mijn eigen huis. Niet mijn sterkste moment. Maar jij kunt me helpen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("3_choice")
text = "Wijd me dan in."
next = &"initiation"
condition = SubResource("Condition_4")

[sub_resource type="Resource" id="Choice_4"]
script = ExtResource("3_choice")
text = "Vertel eerst over Amber."
next = &"lore_1"

[sub_resource type="Resource" id="Choice_5"]
script = ExtResource("3_choice")
text = "Later."
next = &"bye"

[sub_resource type="Resource" id="Line_task"]
script = ExtResource("4_line")
id = &"task"
text = "Eerst wil ik zien wat je kunt. Zolang ik je niet heb ingewijd, blijft mijn winkel dicht."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_3"), SubResource("Choice_4"), SubResource("Choice_5")])

[sub_resource type="Resource" id="Line_initiation"]
script = ExtResource("4_line")
id = &"initiation"
text = "Goed. Vanaf nu ben je ingewijd. Niveau één. Ga er niet van naast je schoenen lopen."
next = &"hub"
action = &"raise_inwijding"
action_value = "1"
model_action = &"flex"

[sub_resource type="Resource" id="Line_glasses"]
script = ExtResource("4_line")
id = &"glasses"
text = "Deze bril gaat nooit af. Nooit. Volgende vraag."
next = &"hub"

[sub_resource type="Resource" id="Line_greeting_strong"]
script = ExtResource("4_line")
id = &"greeting_strong"
text = "Kijk eens wie er spieren krijgt. Bijna zoveel als ik. Bijna."
next = &"hub"
condition = SubResource("Condition_5")
model_action = &"flex"

[sub_resource type="Resource" id="Line_greeting"]
script = ExtResource("4_line")
id = &"greeting"
text = "Daar is mijn favoriete niemand."
next = &"hub"
condition = SubResource("Condition_1")

[sub_resource type="Resource" id="Choice_6"]
script = ExtResource("3_choice")
text = "Laat je winkel zien."
condition = SubResource("Condition_3")
action = &"open_shop"

[sub_resource type="Resource" id="Choice_7"]
script = ExtResource("3_choice")
text = "Wijd me in."
next = &"initiation"
condition = SubResource("Condition_4")

[sub_resource type="Resource" id="Choice_8"]
script = ExtResource("3_choice")
text = "Vertel over Amber."
next = &"lore_1"

[sub_resource type="Resource" id="Choice_9"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"glasses"

[sub_resource type="Resource" id="Choice_10"]
script = ExtResource("3_choice")
text = "Mag ik hier slapen?"
next = &"sleep_offer"

[sub_resource type="Resource" id="Choice_11"]
script = ExtResource("3_choice")
text = "Tot later."
next = &"bye"

[sub_resource type="Resource" id="Line_hub"]
script = ExtResource("4_line")
id = &"hub"
text = "Wat wil je?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_6"), SubResource("Choice_7"), SubResource("Choice_8"), SubResource("Choice_9"), SubResource("Choice_10"), SubResource("Choice_11")])

[sub_resource type="Resource" id="Line_lore_1"]
script = ExtResource("4_line")
id = &"lore_1"
text = "Amber kwam uit Arnhem-Zuid. Groot, oranje, slecht humeur. Ze nam Elst over en zette overal haar drillers neer."
next = &"lore_2"

[sub_resource type="Resource" id="Line_lore_2"]
script = ExtResource("4_line")
id = &"lore_2"
text = "Sinds die dag draait er een tornado om het dorp. Niemand erin, niemand eruit. Station Elst is haar aanvoerlijn. Die moet kapot."
next = &"hub"

[sub_resource type="Resource" id="Choice_12"]
script = ExtResource("3_choice")
text = "Ik ga slapen."
action = &"sleep"

[sub_resource type="Resource" id="Choice_13"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_sleep_offer"]
script = ExtResource("4_line")
id = &"sleep_offer"
text = "Het bed staat achterin. Schoenen uit. Slapen is ook trainen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_12"), SubResource("Choice_13")])

[sub_resource type="Resource" id="Line_bye"]
script = ExtResource("4_line")
id = &"bye"
text = "Train hard. Of in elk geval een beetje."

[resource]
script = ExtResource("1_data")
speaker = "Klaas"
starts = Array[StringName]([&"first_meeting", &"greeting_strong", &"greeting"])
lines = Array[ExtResource("4_line")]([SubResource("Line_first_meeting"), SubResource("Line_first_2"), SubResource("Line_first_3"), SubResource("Line_task"), SubResource("Line_initiation"), SubResource("Line_glasses"), SubResource("Line_greeting_strong"), SubResource("Line_greeting"), SubResource("Line_hub"), SubResource("Line_lore_1"), SubResource("Line_lore_2"), SubResource("Line_sleep_offer"), SubResource("Line_bye")])
