[ext_resource type="PackedScene" path="res://scenes/world/props/Chest.tscn" id="22_chest"]

[sub_resource type="Environment" id="Environment_dungeon"]
background_mode = 1
background_color = Color(0.03, 0.03, 0.04, 1)
ambient_light_source = 2
ambient_light_color = Color(0.75, 0.62, 0.18, 1)
ambient_light_energy = 0.35

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.25, 0.24, 0.22, 1)
specular_mode = 2

[sub_resource type="StandardMaterial3D" id="Mat_wall"]
albedo_color = Color(0.75, 0.62, 0.18, 1)
specular_mode = 2

[sub_resource type="StandardMaterial3D" id="Mat_accent"]
albedo_color = Color(0.1, 0.1, 0.11, 1)
specular_mode = 2

[sub_resource type="BoxMesh" id="Mesh_floor"]
material = SubResource("Mat_floor")
size = Vector3(20, 1, 30)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(20, 1, 30)

[sub_resource type="BoxMesh" id="Mesh_ceiling"]
