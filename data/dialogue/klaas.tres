[sub_resource type="Resource" id="Choice_16"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q5_busy"
condition = SubResource("Condition_21")

[sub_resource type="Resource" id="Choice_17"]
script = ExtResource("3_choice")
text = "Wat nu met Amber?"
next = &"q6_go"
condition = SubResource("Condition_24")

[sub_resource type="Resource" id="Choice_18"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"next_job"
condition = SubResource("Condition_25")

[sub_resource type="Resource" id="Choice_19"]
script = ExtResource("3_choice")
text = "Vertel over Amber."
next = &"lore_1"

[sub_resource type="Resource" id="Choice_20"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"glasses"

[sub_resource type="Resource" id="Choice_21"]
script = ExtResource("3_choice")
text = "Mag ik hier slapen?"
next = &"sleep_offer"

[sub_resource type="Resource" id="Choice_22"]
script = ExtResource("3_choice")
text = "Tot later."
next = &"bye"

[sub_resource type="Resource" id="Line_hub"]
script = ExtResource("4_line")
id = &"hub"
text = "Wat wil je?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_4"), SubResource("Choice_5"), SubResource("Choice_6"), SubResource("Choice_7"), SubResource("Choice_8"), SubResource("Choice_9"), SubResource("Choice_10"), SubResource("Choice_11"), SubResource("Choice_12"), SubResource("Choice_13"), SubResource("Choice_14"), SubResource("Choice_15"), SubResource("Choice_16"), SubResource("Choice_17"), SubResource("Choice_18"), SubResource("Choice_19"), SubResource("Choice_20"), SubResource("Choice_21"), SubResource("Choice_22")])

[sub_resource type="Resource" id="Line_q2_offer"]
script = ExtResource("4_line")
id = &"q2_offer"
text = "Station Elst is Ambers aanvoerlijn. Elke nacht rijden er treinen vol eiwitshakes en ander spul naar haar leger."
next = &"q2_offer_2"

[sub_resource type="Resource" id="Line_q2_offer_2"]
script = ExtResource("4_line")
id = &"q2_offer_2"
text = "Vier generators houden trein en spoor draaiende. Sla ze alle vier kapot. Pas op: achterin ligt haar depot, en dat bewaken ze goed."
next = &"q2_offer_3"

[sub_resource type="Resource" id="Choice_23"]
script = ExtResource("3_choice")
text = "Ik sloop dat station."
next = &"q2_go"
action = &"start_quest"
action_value = "q2_station"

[sub_resource type="Resource" id="Choice_24"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_offer_3"]
script = ExtResource("4_line")
id = &"q2_offer_3"
text = "En zolang dat station draait, houdt Amber Westeraam, het OBC en de Bingo Club op slot. Eerst het station, dan pas de rest."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_23"), SubResource("Choice_24")])

[sub_resource type="Resource" id="Line_q2_go"]
script = ExtResource("4_line")
id = &"q2_go"
text = "Zo mag ik het horen. De ingang zit in het gebouw naast het station. Het kompas wijst je de weg."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_busy"]
script = ExtResource("4_line")
id = &"q2_busy"
text = "Die generators draaien nog. Ik hoor het gezoem tot hier."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_early"]
script = ExtResource("4_line")
id = &"q2_early"
text = "Wacht even. Het station ligt al plat? Ik had het je nog niet eens gevraagd."
next = &"q2_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q2_early_2"]
script = ExtResource("4_line")
id = &"q2_early_2"
text = "Eerder klaar dan gevraagd. Dat noem ik inzet. Hier, je beloning."
next = &"hub"
action = &"start_quest"
action_value = "q2_station"

[sub_resource type="Resource" id="Line_q3_offer"]
script = ExtResource("4_line")
id = &"q3_offer"
text = "Nu het station plat ligt, zijn de deuren van de wijken open. Westeraam Getho is van de drillers. Hun baas noemt zichzelf de Vape-koning: de rijkste vapeverkoper van het dorp."
next = &"q3_offer_2"

[sub_resource type="Resource" id="Choice_25"]
script = ExtResource("3_choice")
text = "Ik pak die Vape-koning."
next = &"q3_go"
action = &"start_quest"
action_value = "q3_westeraam"

[sub_resource type="Resource" id="Choice_26"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_offer_2"]
script = ExtResource("4_line")
id = &"q3_offer_2"
text = "Hij verstopt zich in zijn eigen vapewolken en schiet van daaruit. Loop recht op zijn wolk af, dan staat hij even te hoesten. Dat is je kans."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_25"), SubResource("Choice_26")])

[sub_resource type="Resource" id="Line_q3_go"]
script = ExtResource("4_line")
id = &"q3_go"
text = "Westeraam ligt aan de overkant van het spoor. De ingang zit in de flats. Neem drankjes mee."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_busy"]
script = ExtResource("4_line")
id = &"q3_busy"
text = "De Vape-koning zit nog op zijn troon. Ik ruik het tot hier."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_early"]
script = ExtResource("4_line")
id = &"q3_early"
text = "Ik hoorde het al. De Vape-koning is verslagen, en ik had het je niet eens gevraagd."
next = &"q3_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q3_early_2"]
script = ExtResource("4_line")
id = &"q3_early_2"
text = "Dat noem ik nou een echte Elstenaar in wording. Hier, je beloning."
next = &"hub"
action = &"start_quest"
action_value = "q3_westeraam"

[sub_resource type="Resource" id="Line_q4_offer"]
script = ExtResource("4_line")
id = &"q4_offer"
text = "Bij het OBC hebben een stel kakkers de school ingenomen. Ze schieten met voetballen en rijden op fatbikes alsof het paarden zijn."
next = &"q4_offer_2"

[sub_resource type="Resource" id="Choice_27"]
script = ExtResource("3_choice")
text = "Ik pak dat fatbike-kindje."
next = &"q4_go"
action = &"start_quest"
action_value = "q4_obc"

[sub_resource type="Resource" id="Choice_28"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q4_offer_2"]
script = ExtResource("4_line")
id = &"q4_offer_2"
text = "Hun baas is een klein kindje op een veel te grote, opgevoerde fatbike. Hoor je de motor gieren, spring dan opzij. Knalt hij tegen een muur, dan is hij even versuft."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_27"), SubResource("Choice_28")])

[sub_resource type="Resource" id="Line_q4_go"]
script = ExtResource("4_line")
id = &"q4_go"
text = "Het OBC ligt helemaal in het zuidwesten. Pas op voor de ballen."
next = &"hub"

[sub_resource type="Resource" id="Line_q4_busy"]
script = ExtResource("4_line")
id = &"q4_busy"
text = "Ik hoor die opgevoerde fatbike nog steeds gieren. Je bent nog niet klaar."
next = &"hub"

[sub_resource type="Resource" id="Line_q4_early"]
script = ExtResource("4_line")
id = &"q4_early"
text = "Dat gegier is gestopt. Heb jij het fatbike-kindje al van zijn fiets geduwd?"
next = &"q4_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q4_early_2"]
script = ExtResource("4_line")
id = &"q4_early_2"
text = "Eerder klaar dan gevraagd. Ik ben trots op je. Hier, je beloning."
next = &"hub"
action = &"start_quest"
action_value = "q4_obc"

[sub_resource type="Resource" id="Line_q5_offer"]
script = ExtResource("4_line")
id = &"q5_offer"
text = "De Bingo Club is een grot geworden. Opa's slaan met hun wandelstok, oma's springen je met hun tasje te lijf en de rolstoel-oma's schieten bingokaarten."
next = &"q5_offer_2"

[sub_resource type="Resource" id="Choice_29"]
script = ExtResource("3_choice")
text = "Ik pak Grumpy Oma."
next = &"q5_go"
action = &"start_quest"
action_value = "q5_bingo"

[sub_resource type="Resource" id="Choice_30"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q5_offer_2"]
script = ExtResource("4_line")
id = &"q5_offer_2"
text = "Hun leider is Grumpy Oma: de nummer 1 van de bingo en een trouwe volger van Amber. Voor die oudjes is ze een messias. Ontwijk haar klap, spring over haar schokgolf en sla hard als ze uitgeput is."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_29"), SubResource("Choice_30")])

[sub_resource type="Resource" id="Line_q5_go"]
script = ExtResource("4_line")
id = &"q5_go"
text = "De Bingo Club ligt vlak bij de kerk. Neem veel drankjes mee, en vergeet je bingokaart niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q5_busy"]
script = ExtResource("4_line")
id = &"q5_busy"
text = "Ik hoor ze nog steeds BINGO roepen. Grumpy Oma zit nog in haar grot."
next = &"hub"

[sub_resource type="Resource" id="Line_q5_early"]
script = ExtResource("4_line")
id = &"q5_early"
text = "Het is stil in de Bingo Club. Heb jij Grumpy Oma al verslagen?"
next = &"q5_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q5_early_2"]
script = ExtResource("4_line")
id = &"q5_early_2"
text = "Eerder klaar dan gevraagd. Ik ben trots op je. Hier, je beloning."
next = &"q5_crossbow"
action = &"start_quest"
action_value = "q5_bingo"

[sub_resource type="Resource" id="Line_next_job"]
script = ExtResource("4_line")
id = &"next_job"
text = "Nog niet. Rust uit. Ik roep je als Amber weer iets flikt."
next = &"hub"

[sub_resource type="Resource" id="Line_q6_go"]
script = ExtResource("4_line")
id = &"q6_go"
text = "De kerk is open. Amber zit diep eronder. Ik ga vooruit en wacht bij haar hol. Kom zodra je klaar bent."
next = &"hub"
model_action = &"flex"

[sub_resource type="Resource" id="Line_lore_1"]
script = ExtResource("4_line")
id = &"lore_1"
text = "Amber kwam uit Arnhem-Zuid. Groot, oranje, slecht humeur. Ze nam Elst over en zette overal haar drillers neer."
next = &"lore_2"

[sub_resource type="Resource" id="Line_lore_2"]
script = ExtResource("4_line")
id = &"lore_2"
text = "Sinds die dag draait er een tornado om het dorp. Niemand erin, niemand eruit. Station Elst is haar aanvoerlijn. Die moet kapot."
next = &"hub"

[sub_resource type="Resource" id="Line_glasses"]
script = ExtResource("4_line")
id = &"glasses"
text = "Deze bril gaat nooit af. Nooit. Volgende vraag."
next = &"hub"

[sub_resource type="Resource" id="Choice_31"]
script = ExtResource("3_choice")
text = "Ik ga slapen."
action = &"sleep"

[sub_resource type="Resource" id="Choice_32"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_sleep_offer"]
script = ExtResource("4_line")
id = &"sleep_offer"
text = "Het bed staat achterin. Schoenen uit. Slapen is ook trainen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_31"), SubResource("Choice_32")])

[sub_resource type="Resource" id="Line_bye"]
script = ExtResource("4_line")
id = &"bye"
text = "Train hard. Of in elk geval een beetje."

