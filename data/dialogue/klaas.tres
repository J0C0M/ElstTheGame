[sub_resource type="Resource" id="Line_first_meeting"]
script = ExtResource("4_line")
id = &"first_meeting"
text = "Hé. Jij bent nieuw hier. Dat zie ik aan je loopje."
next = &"first_2"
condition = SubResource("Condition_1")
model_action = &"flex"

[sub_resource type="Resource" id="Line_first_2"]
script = ExtResource("4_line")
id = &"first_2"
text = "Ik ben Klaas. Ik beschermde Elst. Tot Amber de Draak kwam, met haar leger drillers uit Arnhem-Zuid."
next = &"first_3"

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("3_choice")
text = "Wat moet ik doen?"
next = &"tutorial_1"

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"first_glasses"

[sub_resource type="Resource" id="Line_first_3"]
script = ExtResource("4_line")
id = &"first_3"
text = "Nu zit ik ondergedoken in mijn eigen huis. Niet mijn sterkste moment. Maar jij kunt me helpen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("3_choice")
text = "Wat moet ik doen?"
next = &"tutorial_1"

[sub_resource type="Resource" id="Line_first_glasses"]
script = ExtResource("4_line")
id = &"first_glasses"
text = "Deze bril gaat nooit af. Nooit. Volgende vraag."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_3")])

[sub_resource type="Resource" id="Line_tutorial_1"]
script = ExtResource("4_line")
id = &"tutorial_1"
text = "Eerst wil ik zien wat je kunt. Hier, een zwaard. Roestig, maar het snijdt."
next = &"tutorial_2"
action = &"give_item"
action_value = "rusty_sword"

[sub_resource type="Resource" id="Line_tutorial_2"]
script = ExtResource("4_line")
id = &"tutorial_2"
text = "Ga naar buiten. Sprint, spring en ontwijk. Sla daarna mijn trainingspop kapot en leer blokkeren bij de sparringpop."
next = &"tutorial_3"

[sub_resource type="Resource" id="Line_tutorial_3"]
script = ExtResource("4_line")
id = &"tutorial_3"
text = "Raak je de weg kwijt? Je questlog staat onder J, en het kompas bovenin wijst de weg. Vooruit."
action = &"set_flag"
action_value = "q1_met_klaas"

[sub_resource type="Resource" id="Line_tutorial_report"]
script = ExtResource("4_line")
id = &"tutorial_report"
text = "Twee drillers in één keer. Niet slecht, voor een niemand."
next = &"tutorial_reward"
condition = SubResource("Condition_2")
model_action = &"flex"

[sub_resource type="Resource" id="Line_tutorial_reward"]
script = ExtResource("4_line")
id = &"tutorial_reward"
text = "Je bent nu ingewijd. Mijn winkel staat voor je open. En hier, wat goud en twee drankjes. Niet alles in één keer opmaken."
next = &"hub"
action = &"set_flag"
action_value = "q1_reported"

[sub_resource type="Resource" id="Line_tutorial_busy"]
script = ExtResource("4_line")
id = &"tutorial_busy"
text = "Ik zie nog geen resultaten. Kijk in je questlog als je niet weet wat je moet doen."
condition = SubResource("Condition_3")

[sub_resource type="Resource" id="Line_q2_report"]
script = ExtResource("4_line")
id = &"q2_report"
text = "Het is stil op het spoor. Geen trein meer voor Amber. Dat heb jij gedaan."
next = &"q2_reward"
condition = SubResource("Condition_8")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q2_reward"]
script = ExtResource("4_line")
id = &"q2_reward"
text = "Zonder aanvoer zijn haar drillers in Westeraam en bij het OBC een stuk slapper. Hier, je beloning."
next = &"hub"
action = &"set_flag"
action_value = "q2_reported"

[sub_resource type="Resource" id="Line_q3_report"]
script = ExtResource("4_line")
id = &"q3_report"
text = "De Vape-koning is weg? Dan kan Westeraam eindelijk weer ademen."
next = &"q3_reward"
condition = SubResource("Condition_12")
model_action = &"flex"

[sub_resource type="Resource" id="Line_q3_reward"]
script = ExtResource("4_line")
id = &"q3_reward"
text = "De mensen lopen alweer over straat. Hier, 150 goud. Die heb je verdiend."
next = &"hub"
action = &"set_flag"
action_value = "q3_reported"

[sub_resource type="Resource" id="Line_greeting_strong"]
script = ExtResource("4_line")
id = &"greeting_strong"
text = "Kijk eens wie er spieren krijgt. Bijna zoveel als ik. Bijna."
next = &"hub"
condition = SubResource("Condition_15")
model_action = &"flex"

[sub_resource type="Resource" id="Line_greeting"]
script = ExtResource("4_line")
id = &"greeting"
text = "Daar is mijn favoriete niemand."
next = &"hub"

[sub_resource type="Resource" id="Choice_4"]
script = ExtResource("3_choice")
text = "Laat je winkel zien."
condition = SubResource("Condition_14")
action = &"open_shop"

[sub_resource type="Resource" id="Choice_5"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q2_offer"
condition = SubResource("Condition_5")

[sub_resource type="Resource" id="Choice_6"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q2_early"
condition = SubResource("Condition_6")

[sub_resource type="Resource" id="Choice_7"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q2_busy"
condition = SubResource("Condition_7")

[sub_resource type="Resource" id="Choice_8"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q3_offer"
condition = SubResource("Condition_9")

[sub_resource type="Resource" id="Choice_9"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q3_early"
condition = SubResource("Condition_10")

[sub_resource type="Resource" id="Choice_10"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"q3_busy"
condition = SubResource("Condition_11")

[sub_resource type="Resource" id="Choice_11"]
script = ExtResource("3_choice")
text = "Heb je nog een klus?"
next = &"next_job"
condition = SubResource("Condition_13")

[sub_resource type="Resource" id="Choice_12"]
script = ExtResource("3_choice")
text = "Vertel over Amber."
next = &"lore_1"

[sub_resource type="Resource" id="Choice_13"]
script = ExtResource("3_choice")
text = "Waarom die zonnebril?"
next = &"glasses"

[sub_resource type="Resource" id="Choice_14"]
script = ExtResource("3_choice")
text = "Mag ik hier slapen?"
next = &"sleep_offer"

[sub_resource type="Resource" id="Choice_15"]
script = ExtResource("3_choice")
text = "Tot later."
next = &"bye"

[sub_resource type="Resource" id="Line_hub"]
script = ExtResource("4_line")
id = &"hub"
text = "Wat wil je?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_4"), SubResource("Choice_5"), SubResource("Choice_6"), SubResource("Choice_7"), SubResource("Choice_8"), SubResource("Choice_9"), SubResource("Choice_10"), SubResource("Choice_11"), SubResource("Choice_12"), SubResource("Choice_13"), SubResource("Choice_14"), SubResource("Choice_15")])

[sub_resource type="Resource" id="Line_q2_offer"]
script = ExtResource("4_line")
id = &"q2_offer"
text = "Station Elst is Ambers aanvoerlijn. Elke nacht rijden er treinen vol eiwitshakes en ander spul naar haar leger."
next = &"q2_offer_2"

[sub_resource type="Resource" id="Choice_16"]
script = ExtResource("3_choice")
text = "Ik sloop dat station."
next = &"q2_go"
action = &"start_quest"
action_value = "q2_station"

[sub_resource type="Resource" id="Choice_17"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_offer_2"]
script = ExtResource("4_line")
id = &"q2_offer_2"
text = "Vier generators houden trein en spoor draaiende. Sla ze alle vier kapot. Pas op: achterin ligt haar depot, en dat bewaken ze goed."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_16"), SubResource("Choice_17")])

[sub_resource type="Resource" id="Line_q2_go"]
script = ExtResource("4_line")
id = &"q2_go"
text = "Zo mag ik het horen. De ingang zit in het gebouw naast het station. Het kompas wijst je de weg."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_busy"]
script = ExtResource("4_line")
id = &"q2_busy"
text = "Die generators draaien nog. Ik hoor het gezoem tot hier."
next = &"hub"

[sub_resource type="Resource" id="Line_q2_early"]
script = ExtResource("4_line")
id = &"q2_early"
text = "Wacht even. Het station ligt al plat? Ik had het je nog niet eens gevraagd."
next = &"q2_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q2_early_2"]
script = ExtResource("4_line")
id = &"q2_early_2"
text = "Eerder klaar dan gevraagd. Dat noem ik inzet. Hier, je beloning."
next = &"hub"
action = &"start_quest"
action_value = "q2_station"

[sub_resource type="Resource" id="Line_q3_offer"]
script = ExtResource("4_line")
id = &"q3_offer"
text = "Westeraam Getho is van de drillers. Hun baas noemt zichzelf de Vape-koning: de rijkste vapeverkoper van het dorp."
next = &"q3_offer_2"

[sub_resource type="Resource" id="Choice_18"]
script = ExtResource("3_choice")
text = "Ik pak die Vape-koning."
next = &"q3_go"
action = &"start_quest"
action_value = "q3_westeraam"

[sub_resource type="Resource" id="Choice_19"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_offer_2"]
script = ExtResource("4_line")
id = &"q3_offer_2"
text = "Hij verstopt zich in zijn eigen vapewolken en schiet van daaruit. Loop recht op zijn wolk af, dan staat hij even te hoesten. Dat is je kans."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_18"), SubResource("Choice_19")])

[sub_resource type="Resource" id="Line_q3_go"]
script = ExtResource("4_line")
id = &"q3_go"
text = "Westeraam ligt aan de overkant van het spoor. De ingang zit in de flats. Neem drankjes mee."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_busy"]
script = ExtResource("4_line")
id = &"q3_busy"
text = "De Vape-koning zit nog op zijn troon. Ik ruik het tot hier."
next = &"hub"

[sub_resource type="Resource" id="Line_q3_early"]
script = ExtResource("4_line")
id = &"q3_early"
text = "Ik hoorde het al. De Vape-koning is verslagen, en ik had het je niet eens gevraagd."
next = &"q3_early_2"
model_action = &"flex"

[sub_resource type="Resource" id="Line_q3_early_2"]
script = ExtResource("4_line")
id = &"q3_early_2"
text = "Dat noem ik nou een echte Elstenaar in wording. Hier, je beloning."
next = &"hub"
action = &"start_quest"
action_value = "q3_westeraam"

[sub_resource type="Resource" id="Line_next_job"]
script = ExtResource("4_line")
id = &"next_job"
text = "Nog niet. Rust uit. Ik roep je als Amber weer iets flikt."
next = &"hub"

[sub_resource type="Resource" id="Line_lore_1"]
script = ExtResource("4_line")
id = &"lore_1"
text = "Amber kwam uit Arnhem-Zuid. Groot, oranje, slecht humeur. Ze nam Elst over en zette overal haar drillers neer."
next = &"lore_2"

[sub_resource type="Resource" id="Line_lore_2"]
script = ExtResource("4_line")
id = &"lore_2"
text = "Sinds die dag draait er een tornado om het dorp. Niemand erin, niemand eruit. Station Elst is haar aanvoerlijn. Die moet kapot."
next = &"hub"

[sub_resource type="Resource" id="Line_glasses"]
script = ExtResource("4_line")
id = &"glasses"
text = "Deze bril gaat nooit af. Nooit. Volgende vraag."
next = &"hub"

[sub_resource type="Resource" id="Choice_20"]
script = ExtResource("3_choice")
text = "Ik ga slapen."
action = &"sleep"

[sub_resource type="Resource" id="Choice_21"]
script = ExtResource("3_choice")
text = "Nog even niet."
next = &"hub"

[sub_resource type="Resource" id="Line_sleep_offer"]
script = ExtResource("4_line")
id = &"sleep_offer"
text = "Het bed staat achterin. Schoenen uit. Slapen is ook trainen."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_20"), SubResource("Choice_21")])

[sub_resource type="Resource" id="Line_bye"]
script = ExtResource("4_line")
id = &"bye"
text = "Train hard. Of in elk geval een beetje."

[resource]
script = ExtResource("1_data")
speaker = "Klaas"
starts = Array[StringName]([&"first_meeting", &"tutorial_report", &"tutorial_busy", &"q2_report", &"q3_report", &"greeting_strong", &"greeting"])
lines = Array[ExtResource("4_line")]([SubResource("Line_first_meeting"), SubResource("Line_first_2"), SubResource("Line_first_3"), SubResource("Line_first_glasses"), SubResource("Line_tutorial_1"), SubResource("Line_tutorial_2"), SubResource("Line_tutorial_3"), SubResource("Line_tutorial_report"), SubResource("Line_tutorial_reward"), SubResource("Line_tutorial_busy"), SubResource("Line_q2_report"), SubResource("Line_q2_reward"), SubResource("Line_q3_report"), SubResource("Line_q3_reward"), SubResource("Line_greeting_strong"), SubResource("Line_greeting"), SubResource("Line_hub"), SubResource("Line_q2_offer"), SubResource("Line_q2_offer_2"), SubResource("Line_q2_go"), SubResource("Line_q2_busy"), SubResource("Line_q2_early"), SubResource("Line_q2_early_2"), SubResource("Line_q3_offer"), SubResource("Line_q3_offer_2"), SubResource("Line_q3_go"), SubResource("Line_q3_busy"), SubResource("Line_q3_early"), SubResource("Line_q3_early_2"), SubResource("Line_next_job"), SubResource("Line_lore_1"), SubResource("Line_lore_2"), SubResource("Line_glasses"), SubResource("Line_sleep_offer"), SubResource("Line_bye")])
